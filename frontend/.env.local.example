NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Backend API base used by the Next.js server (server components and server
# actions). Falls back to NEXT_PUBLIC_API_BASE_URL when unset; set it when the
# server reaches the backend under a different address, for example
# http://backend:4000/api/v1 inside Docker Compose.
# INTERNAL_API_BASE_URL=http://backend:4000/api/v1
