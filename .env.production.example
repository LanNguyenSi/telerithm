POSTGRES_PASSWORD=change-me
LOG_LEVEL=info
OPENAI_API_KEY=

# Registration modes: open, invite-only, approval
REGISTRATION_MODE=approval

# Bootstrap admin that can sign up even when approval/invite-only is enabled
ADMIN_EMAIL=admin@example.com

# Reverse-proxy hops in front of the backend, for the IP-keyed rate limiters.
# Defaults to 1 (Traefik only) in docker-compose.traefik.yml; raise it if a CDN
# or another proxy sits in front of Traefik. See docs/configuration.md.
# TRUST_PROXY=1

# Used by docker-compose.prod.yml only (docker-compose.traefik.yml hardcodes
# its public host name instead, see DEPLOYMENT.md). Without them, prod.yml
# falls back to localhost values: the frontend image is built with an API URL
# of http://localhost:4000/api/v1 and the backend accepts only
# http://localhost:3000 as a browser origin.
# PUBLIC_API_URL is baked into the frontend at build time: rebuild the
# frontend image after changing it.
# PUBLIC_API_URL=https://telerithm.example.com/api/v1
# CORS_ORIGINS=https://telerithm.example.com
