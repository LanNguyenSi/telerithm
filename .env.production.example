POSTGRES_PASSWORD=change-me
LOG_LEVEL=info
OPENAI_API_KEY=

# Registration modes: open, invite-only, approval
REGISTRATION_MODE=approval

# Bootstrap admin that can sign up even when approval/invite-only is enabled
ADMIN_EMAIL=admin@example.com

# Reverse-proxy hops in front of the backend, for the IP-keyed rate limiters.
# Defaults to 1 (Traefik only) in docker-compose.traefik.yml; raise it if a CDN
# or another proxy sits in front of Traefik. See docs/configuration.md.
# TRUST_PROXY=1
