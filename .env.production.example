# Required. docker-compose.prod.yml and docker-compose.traefik.yml refuse to
# start without it: both uses in each file interpolate it with the :? form, so
# compose fails instead of filling in a default, and make deploy checks it
# before building anything.
POSTGRES_PASSWORD=change-me
LOG_LEVEL=info
# Keep this line, empty for the heuristic search fallback: docker-compose.traefik.yml
# interpolates it bare, so make deploy refuses when the line is missing.
OPENAI_API_KEY=

# Registration modes: open, invite-only, approval
REGISTRATION_MODE=approval

# Bootstrap admin that can sign up even when approval/invite-only is enabled.
# Set this to your own address before the first start: the first account that
# registers with this address becomes the instance admin without approval, and
# addresses are not verified. With the line empty (below) nobody becomes admin
# in approval/invite-only mode: no account can be approved and nobody can
# sign in, until you put your own address here and register it.
ADMIN_EMAIL=

# Reverse-proxy hops in front of the backend, for the IP-keyed rate limiters.
# Defaults to 1 (Traefik only) in docker-compose.traefik.yml; raise it if a CDN
# or another proxy sits in front of Traefik. See docs/configuration.md.
# TRUST_PROXY=1

# Bearer token for GET /metrics and the per-dependency checks of
# GET /api/v1/health (at least 32 characters when set, see
# backend/.env.example). Both prod composes interpolate it into the backend as
# ${METRICS_TOKEN:-}: unset or empty, /metrics answers 404 (endpoint disabled)
# and health answers { status } only. Set it before deploying if you scrape
# metrics, and point the scrape's authorization at the same value
# (DEPLOYMENT.md, "Prometheus metrics").
# METRICS_TOKEN=

# Used by docker-compose.prod.yml only (docker-compose.traefik.yml hardcodes
# its public host name instead, see DEPLOYMENT.md). Without them, prod.yml
# falls back to localhost values: the frontend image is built with an API URL
# of http://localhost:4000/api/v1 and the backend accepts only
# http://localhost:3000 as a browser origin.
# PUBLIC_API_URL is baked into the frontend at build time: rebuild the
# frontend image after changing it.
# PUBLIC_API_URL=https://telerithm.example.com/api/v1
# CORS_ORIGINS=https://telerithm.example.com
