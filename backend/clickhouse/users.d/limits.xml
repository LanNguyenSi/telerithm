<clickhouse>
    <!-- Profiles are read from the users config (users.xml and users.d), never
         from config.d: a <profiles> block in config.d is ignored and the
         settings stay at their default of 0 (unlimited). -->
    <profiles>
        <default>
            <max_memory_usage>2147483648</max_memory_usage>
            <max_bytes_before_external_group_by>1073741824</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>1073741824</max_bytes_before_external_sort>
        </default>
    </profiles>
</clickhouse>
