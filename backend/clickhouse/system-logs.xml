<!--
    Retention for ClickHouse's INTERNAL system log tables. Without this,
    system.text_log grows unbounded: on 2026-07-15 it held 133 GiB /
    2.5 billion rows on VPS-01 (~80% of the whole disk) while the actual
    telerithm data stayed tiny.

    text_log duplicates the server's stderr log into a MergeTree table and
    is pure ClickHouse-internal diagnostics; we disable it outright.

    metric_log, asynchronous_metric_log, trace_log, processors_profile_log
    and query_metric_log are disabled too: telerithm never reads them, and
    metric_log alone (one wide row per second) kept two cores busy with
    background merges on VPS-01 (2.16 GiB, 516 active parts on 2026-10-24,
    TTL notwithstanding). The remaining system logs (query_log,
    query_thread_log, part_log, error_log) are kept 7 days via TTL so
    short-window debugging stays possible.

    NOTE: a TTL config change only applies to NEWLY created tables. On the
    first restart with this file, ClickHouse renames each existing table to
    <name>_N and creates a fresh one with the TTL; the renamed leftovers can
    be dropped manually if they ever matter for disk (after the 2026-07-15
    truncate they are empty).
-->
<clickhouse>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <trace_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_metric_log remove="1"/>
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <query_thread_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_thread_log>
    <part_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>
    <error_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </error_log>
</clickhouse>
