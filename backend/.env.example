# Server
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Demo seed: when NODE_ENV=production the demo/admin seed data is skipped
# unless this is set to "true". Keep it unset (or false) in real production.
# SEED_DEMO_DATA=true

# Signup: open (every new account is active), approval (default; an admin
# approves new accounts) or invite-only. Under approval and invite-only only the
# ADMIN_EMAIL account becomes active and instance admin without approval, so set
# it to your own address and register that account first. See docs/configuration.md.
# REGISTRATION_MODE=open
# ADMIN_EMAIL=you@example.com

# PostgreSQL
DATABASE_URL=postgresql://telerithm:telerithm@localhost:5432/telerithm

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123

# Redis (Phase 3)
# REDIS_URL=redis://localhost:6379

# OpenAI (AI query engine)
# Optional: If not provided, falls back to heuristic regex matching
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# Logging
LOG_LEVEL=info

# Rate limit for POST /subscriptions/:id/test (see docs/api.md). Defaults
# shown; uncomment to override.
# NOTIFICATION_TEST_RATE_LIMIT_WINDOW_MS=300000
# NOTIFICATION_TEST_RATE_LIMIT_MAX=5

# Max page size for log search (50 to 500, default 500). It can lower the
# request schema's own limit of 500 but not raise it.
# MAX_PAGE_SIZE=500

# Webhook, Slack and Teams delivery guard (see docs/configuration.md). Read at
# delivery time, not validated at startup.
# WEBHOOK_HOST_ALLOWLIST: comma-separated hostnames; when set, notifications are
# only delivered to these exact hosts (case-insensitive).
# WEBHOOK_NAT64_ADDITIONAL_PREFIXES: comma-separated /96-aligned NAT64 prefixes
# ending in "::" (for example 64:ff9b:1::); the SSRF guard also checks the IPv4
# address embedded under them.
# WEBHOOK_HOST_ALLOWLIST=hooks.example.com,hooks.slack.com
# WEBHOOK_NAT64_ADDITIONAL_PREFIXES=64:ff9b:1::

# Reverse-proxy trust for the IP-keyed rate limiters (see docs/configuration.md).
# Unset (default) = trust no proxy. Accepts a hop count (1 = one reverse proxy),
# "loopback", or a comma-separated list of proxy IPs/CIDRs. "true" is rejected.
# TRUST_PROXY=1
